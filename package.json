{
  "name": "suman-server",
  "version": "0.0.0",
  "private": true,
  "main": "bin/www.js",
  "scripts": {
    "start": "node ./bin/www",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "dependencies": {
    "async": "^2.1.4",
    "body-parser": "~1.17.1",
    "cookie-parser": "~1.4.3",
    "debug": "~2.6.3",
    "express": "~4.15.2",
    "morgan": "~1.8.1",
    "serve-favicon": "~2.4.2",
    "react": "^15.4.2",
    "react-dom": "^15.4.2"
  },
  "devDependencies": {
    "chokidar": "^1.6.1",
    "socket.io": "^1.7.3",
    "@types/async": "^2.0.38",
    "@types/core-js": "^0.9.35",
    "@types/immutable": "^3.8.7",
    "@types/lodash": "^4.14.50",
    "@types/node": "^7.0.0",
    "@types/react": "^15.0.0",
    "@types/react-dom": "^0.14.20",
    "@types/react-redux": "^4.4.35",
    "@types/redux": "^3.6.0",
    "@types/redux-thunk": "^2.1.0",
    "@types/requirejs": "^2.1.28",
    "@types/socket.io": "^1.4.27",
    "@types/socket.io-client": "^1.4.29",
    "@types/whatwg-fetch": "0.0.33",
    "requirejs": "^2.3.2",
    "rimraf": "^2.5.4",
    "roodles": "0.0.1017"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
